# ==============================================================================
# CASH FLOW MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Environment
NODE_ENV="production"
PORT=5000

# Canonical Web Address (Subdomain or Domain on cPanel)
CLIENT_URL="https://cashflow.hawksnfox.com"

# PostgreSQL Database Connection String
# If using cPanel PostgreSQL:
# DATABASE_URL="postgresql://cpaneluser_cashuser:StrongPassword@127.0.0.1:5432/cpaneluser_cashflow?schema=public"
# If using Cloud PostgreSQL (Neon / Supabase / Aiven):
DATABASE_URL="postgresql://user:password@ep-sample-pool.region.neon.tech/neondb?sslmode=require"

# JWT Secret Key (Cryptographically Secure 256-bit Random Hex)
JWT_SECRET="e93a7d4f8b2c1e5a9601d3f572a94ce1883b5d2079f410c841e2a861fbc94017"

# Initial Default Administrator (Created during first run / seed)
DEFAULT_ADMIN_EMAIL="admin@cashflow.local"
DEFAULT_ADMIN_PASSWORD="ChangeMeInProduction!2026"
